# User and Group Configuration
# Set these to match your host user for proper file permissions
PUID=1000
PGID=1000

# Directory Configuration
# Customize paths for media, config, and output directories
MEDIA_DIR=./media
CONFIG_DIR=./config
OUTPUT_DIR=./output

# mnamer Configuration
CONFIG_PATH=/config/.mnamer-v2.json

# Processing Options (for oneshot service)
BATCH_MODE=true
RECURSE=true
VERBOSE=1
LANGUAGE=en
NO_OVERWRITE=false

# Watch Mode Configuration
WATCH_INTERVAL=300

# Version Configuration (optional)
# Uncomment to install a specific version, otherwise installs latest
# VERSION=2.5.5
